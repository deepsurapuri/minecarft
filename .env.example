# --- Gateway HTTP API ---
PORT=3000
HOST=0.0.0.0

# --- Target Bedrock server ---
BDS_HOST=127.0.0.1
BDS_PORT=19132
# Pin a protocol version if the server is not the newest (e.g. BDS_VERSION=1.21.0)
# BDS_VERSION=

# --- Bot auth ---
# offline   -> LAN / online-mode=false servers, no accounts needed (default for local dev)
# microsoft -> Xbox Live sign-in (required when ONLINE_MODE=true, e.g. the public internet)
BOT_AUTH=offline

# --- Storage ---
DATA_DIR=./data
PROFILES_FOLDER=./data/profiles

# --- Safety rails ---
MAX_BOTS=10
RATE_LIMIT_PER_MIN=120
COMMAND_RATE_LIMIT_PER_MIN=60
CHAT_LOG_SIZE=100

# --- raknet backend (rarely needed) ---
# raknet-native = faster but needs a cmake toolchain; jsp-raknet = pure JS (default)
# RAKNET_BACKEND=jsp-raknet
